# Copy this file to .env and customize the values below.
# The evaluator loads .env automatically. Values in your shell take precedence.

# --- Provider and model selection ---
AGENT_PROVIDER=ollama                 # ollama, openrouter, or requesty
# AGENT_MODEL=                         # Optional model override for the selected provider
OLLAMA_MODEL=llama3.1
# OPENROUTER_MODEL=                    # Required when AGENT_PROVIDER=openrouter
# REQUESTY_MODEL=                      # Required when AGENT_PROVIDER=requesty

# --- Provider endpoints ---
OLLAMA_BASE_URL=http://localhost:11434/api/chat
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1/chat/completions
REQUESTY_BASE_URL=https://router.requesty.ai/v1/chat/completions

# --- Credentials ---
# Set only the key for the provider you use. Never commit real API keys.
# OPENROUTER_API_KEY=replace-with-your-key
# REQUESTY_API_KEY=replace-with-your-key
# Optional: change which environment variable name the evaluator reads for a key.
# OPENROUTER_API_KEY_ENV=OPENROUTER_API_KEY
# REQUESTY_API_KEY_ENV=REQUESTY_API_KEY

# --- Evaluation run settings ---
AGENT_TEMPERATURE=0.0
AGENT_TIMEOUT=60
# AGENT_TASKS_PATH=tasks/tasks.json
# AGENT_LOG_PATH=logs/results.jsonl

# --- Clinical benchmark (separate from generic evaluator defaults) ---
# Optional clinical-only overrides. If unset, the clinical runner uses the
# shared AGENT_PROVIDER/model settings (and defaults to Ollama + llama3:8b).
# CLINICAL_PROVIDER=ollama
# CLINICAL_MODEL=llama3:8b
CLINICAL_TASKS_PATH=tasks/clinical_tasks.json
CLINICAL_LOG_PATH=logs/clinical_results.jsonl
